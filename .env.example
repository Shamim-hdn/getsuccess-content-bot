# کلیدهای API خود را اینجا قرار دهید (این فایل را در Vercel به عنوان Environment Variables وارد کنید)

# کلید Gemini از https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# کلید YouTube Data API v3 از https://console.cloud.google.com/
YOUTUBE_API_KEY=your_youtube_api_key_here

# (اختیاری) رمز ساده برای محافظت از اپ، تا فقط خودت بتوانی استفاده کنی
APP_PASSWORD=
